// ============================================
// Mawid — Schéma Prisma
// ============================================
// Documentation : https://pris.ly/d/prisma-schema
// Format auto : npx prisma format

// ---- Générateur du client TypeScript ----
generator client {
  provider      = "prisma-client-js"
  // Cible binaire pour Alpine Linux (notre conteneur Docker)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
  
}

// ---- Source de données : PostgreSQL ----
datasource db {
  provider = "postgresql"
}

// ============================================
// User — Comptes gérants (et admin plateforme)
// ============================================
// En V1 : un User est forcément un gérant.
// En V2+ : on ajoutera des employés (table Employee liée à User).
model User {
  id           String   @id @default(cuid())
  phone        String   @unique // Format E.164 international, ex: +213555123456
  passwordHash String // Bcrypt, jamais stocké en clair
  fullName     String? // Nom complet, optionnel à l'inscription
  role         UserRole @default(MANAGER)

  // Les comptes gérants sont créés par le fondateur (script create-manager)
  // avec un mot de passe initial : on force son changement au premier login
  // plutôt que de laisser vivre un secret connu de deux personnes.
  mustChangePassword Boolean @default(false)

  // Métadonnées
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  // Relations
  // Un gérant peut techniquement avoir plusieurs salons (V2+)
  // En V1, on crée toujours 1 salon par gérant
  salons Salon[]

  @@index([phone])
  @@map("users") // Nom de table en base : users (snake_case par convention SQL)
}

enum UserRole {
  MANAGER // Gérant d'un salon
  ADMIN // Admin plateforme Mawid (toi, fondateur)
}

// ============================================
// Salon — Établissement de coiffure / beauté
// ============================================
model Salon {
  id          String  @id @default(cuid())
  slug        String  @unique // URL friendly, ex: "karim-barber"
  name        String // Nom affiché public
  description String? @db.Text // Optionnel, présentation du salon

  // Numéro WhatsApp public du salon (E.164). Volontairement DISTINCT de
  // User.phone : ce dernier est l'identifiant de connexion du gérant, et
  // l'exposer publiquement faciliterait le bruteforce de son compte.
  contactPhone String

  // Filtre "100 % féminin" de la recherche (business plan §7.1) : un salon
  // réservé aux femmes est un critère de choix déterminant, pas un détail.
  isWomenOnly Boolean @default(false)

  // Adresse
  addressLine String // Ex: "12 rue des Frères Bouadou"
  district    String // Quartier, ex: "Bab Ezzouar"
  city        String @default("Alger") // V1 = Alger uniquement
  latitude    Float? // Pour la carte Google Maps
  longitude   Float?

  // Horaires (V1 simple : 1 plage horaire par jour, fermé certains jours)
  // En V2, on pourrait éclater en table OpeningHours plus riche.
  // Format JSON : { "monday": { "open": "09:00", "close": "20:00" }, "tuesday": null, ... }
  openingHours Json

  // Photos (URLs)
  photos String[] // Array de chemins/URLs vers les images du salon

  // Statut
  // Faux = salon désactivé temporairement, ET état initial d'un salon créé
  // par onboarding self-service tant que le fondateur ne l'a pas validé.
  isActive Boolean @default(true)

  // Offre commerciale (business plan §8.1). Le plan ne déclenche aucun
  // encaissement automatique : il est positionné à la main après paiement.
  plan SalonPlan @default(FREE)

  // Métadonnées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownerId      String
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  prestations  Prestation[]
  employees    Employee[]
  blockedSlots BlockedSlot[]
  reservations Reservation[]

  @@index([slug])
  @@index([ownerId])
  // Recherche publique par ville (business plan §7.1) : on ne liste que les
  // salons actifs d'une ville donnée.
  @@index([city, isActive])
  @@map("salons")
}

enum SalonPlan {
  FREE // 30 RDV/mois
  PRO // Illimité + fonctions avancées
  PRO_PLUS // Pro + caisse et stocks
}

// ============================================
// Employee — Membre de l'équipe d'un salon
// ============================================
// Le multi-employés est une fonctionnalité V2, mais la table existe dès la V1 :
// le calcul de disponibilité est écrit "par ressource", et rétrofiter cette
// notion sur un moteur écrit "par salon" reviendrait à le réécrire.
// En V1, un salon n'a aucun Employee et ses réservations ont employeeId = null,
// ce qui signifie "la ressource unique du salon" (le gérant lui-même).
model Employee {
  id       String  @id @default(cuid())
  salonId  String
  fullName String
  isActive Boolean @default(true)

  // Ordre d'affichage dans le sélecteur "avec qui ?" côté client
  displayOrder Int @default(0)

  // Horaires individuels (V2). null = l'employé suit les horaires du salon.
  // Même format JSON que Salon.openingHours.
  workingHours Json?

  // Métadonnées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salon        Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  blockedSlots BlockedSlot[]

  @@index([salonId])
  @@index([salonId, isActive])
  @@map("employees")
}

// ============================================
// Prestation — Service proposé par un salon
// ============================================
// Ex: "Coupe homme", "Barbe", "Coupe + Barbe combo"
model Prestation {
  id              String  @id @default(cuid())
  salonId         String
  name            String // Ex: "Dégradé américain"
  description     String? @db.Text
  durationMinutes Int // Durée en minutes, ex: 30
  priceCents      Int // Prix en centimes DZD (1500 = 15 DZD), évite virgules flottantes
  isActive        Boolean @default(true) // Faux = ne plus proposer mais conserver l'historique

  // Ordre d'affichage dans la liste publique
  displayOrder Int @default(0)

  // Métadonnées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salon                  Salon                   @relation(fields: [salonId], references: [id], onDelete: Cascade)
  reservationPrestations ReservationPrestation[]

  @@index([salonId])
  @@index([salonId, isActive])
  @@map("prestations")
}

// ============================================
// BlockedSlot — Créneau bloqué manuellement par le gérant
// ============================================
// Ex: rendez-vous personnel, pause longue, fermeture exceptionnelle
model BlockedSlot {
  id       String   @id @default(cuid())
  salonId  String
  startsAt DateTime // Début du blocage (UTC)
  endsAt   DateTime // Fin du blocage (UTC)
  reason   String? // Optionnel : "Pause déjeuner", "RDV perso", etc.

  // null = le salon entier est indisponible (cas V1).
  // Renseigné = seul cet employé est indisponible (V2).
  employeeId String?

  // Métadonnées
  createdAt DateTime @default(now())

  // Relations
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([salonId, startsAt, endsAt])
  @@index([employeeId, startsAt, endsAt])
  @@map("blocked_slots")
}

// ============================================
// Client — Personne qui réserve (pas de compte, pas de mot de passe)
// ============================================
// Le client final ne crée jamais de compte : cette table n'est pas une table
// d'authentification, c'est l'identité métier derrière un numéro de téléphone.
// Elle existe dès la V1 parce que les fiches clients (V3), l'historique et le
// suivi des no-shows deviendraient impossibles à reconstituer a posteriori si
// on se contentait de colonnes brutes sur Reservation.
model Client {
  id        String @id @default(cuid())
  phone     String @unique // Clé naturelle, E.164 — un numéro = une personne
  firstName String // Dernier prénom connu (la réservation en garde un snapshot)

  // Blocage anti-abus. Comme il n'y a pas d'OTP SMS (écarté par la contrainte
  // de gratuité, cf. docs/MVP_SCOPE.md §2.1), c'est avec le rate limiting le
  // seul rempart contre les fausses réservations en série.
  isBlocked Boolean @default(false)

  // Métadonnées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  reservations Reservation[]

  @@index([phone])
  @@map("clients")
}

// ============================================
// Reservation — Réservation d'un client
// ============================================
// Le cœur métier de Mawid.
model Reservation {
  id      String @id @default(cuid())
  salonId String

  // Ressource qui exécute la prestation.
  // null = la ressource unique du salon (le gérant) — cas normal en V1.
  // Renseigné = un employé précis (V2). Le moteur de disponibilité raisonne
  // dès la V1 sur cette notion de ressource, pour ne pas avoir à le réécrire.
  employeeId String?

  // Créneau réservé
  startsAt DateTime // Début (UTC)
  endsAt   DateTime // Fin (UTC), calculé : startsAt + somme des durées prestations

  // Identité du client. clientId est la source de vérité (fiche client,
  // historique) ; les deux champs qui suivent sont des SNAPSHOTS figés au
  // moment du RDV, même logique que nameSnapshot sur ReservationPrestation :
  // corriger une fiche client ne doit jamais réécrire l'historique des RDV.
  clientId        String
  clientFirstName String // Prénom tel que donné ce jour-là
  clientPhone     String // Format E.164, ex: +213555987654

  // Statut
  status ReservationStatus @default(CONFIRMED)

  // Token unique pour permettre annulation/modif via lien wa.me sans login
  cancellationToken String @unique @default(cuid())

  // Notes internes du gérant (privé, jamais montré au client)
  internalNote String? @db.Text

  // Métadonnées
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  // Restrict : on ne supprime pas une fiche client qui porte un historique de
  // RDV. Un droit à l'effacement se traite par anonymisation, pas par DELETE.
  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)

  reservationPrestations ReservationPrestation[]

  @@index([salonId, startsAt])
  @@index([employeeId, startsAt])
  @@index([clientId])
  @@index([clientPhone])
  @@index([cancellationToken])
  @@map("reservations")
}

enum ReservationStatus {
  CONFIRMED // Confirmé, à venir
  HONORED // Client est venu, prestation effectuée
  NO_SHOW // Client ne s'est pas présenté
  CANCELED // Annulé (par le client ou le gérant)
}

// ============================================
// ReservationPrestation — Table de jonction
// ============================================
// Une réservation peut contenir plusieurs prestations (ex: coupe + barbe).
// On stocke aussi le prix au moment de la réservation pour préserver l'historique
// si le tarif change plus tard.
model ReservationPrestation {
  id            String @id @default(cuid())
  reservationId String
  prestationId  String

  // Snapshot au moment de la réservation (immutable)
  nameSnapshot            String
  priceCentsSnapshot      Int
  durationMinutesSnapshot Int

  // Relations
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  prestation  Prestation  @relation(fields: [prestationId], references: [id], onDelete: Restrict)

  @@unique([reservationId, prestationId])
  @@index([reservationId])
  @@map("reservation_prestations")
}
