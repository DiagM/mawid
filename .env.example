# ============================================
# Mawid - Variables d'environnement (exemple)
# ============================================
# Copie ce fichier en .env et adapte les valeurs
# Le .env ne doit JAMAIS être commité (déjà dans .gitignore)

# ---- PostgreSQL ----
POSTGRES_USER=mawid
POSTGRES_PASSWORD=mawid_dev_password
POSTGRES_DB=mawid
POSTGRES_PORT=5433

# ---- Backend NestJS ----
# Note: depuis le conteneur backend, on accède à Postgres via le hostname "postgres"
# (nom du service docker-compose), pas via "localhost"
DATABASE_URL=postgresql://mawid:mawid_dev_password@postgres:5432/mawid?schema=public
BACKEND_PORT=3001
JWT_SECRET=change_me_in_production_to_a_long_random_string

# ---- Frontend Next.js ----
# URL utilisée par le navigateur du client pour appeler le backend
NEXT_PUBLIC_API_URL=http://localhost:3001
FRONTEND_PORT=3000

# ---- Sécurité ----
# Origines autorisées pour CORS, séparées par des virgules.
# OBLIGATOIRE en production : le backend refuse de démarrer sans elle
# (sinon il retomberait silencieusement sur http://localhost:3000).
FRONTEND_ORIGINS=http://localhost:3000

# ---- Limitation de débit (optionnel, valeurs par défaut indiquées) ----
# THROTTLE_DEFAULT_LIMIT=120        # requêtes par minute, toutes routes
# THROTTLE_AUTH_LIMIT=5             # tentatives de login par 15 min
# THROTTLE_BOOKING_LIMIT=60         # réservations par heure et par IP (large : CGNAT)
# THROTTLE_TOKEN_LIMIT=30           # accès par heure à un lien d'annulation

# ---- Règles de réservation (optionnel, valeurs par défaut indiquées) ----
# BOOKING_SLOT_STEP_MINUTES=15
# BOOKING_MIN_LEAD_MINUTES=60
# BOOKING_HORIZON_DAYS=14
# BOOKING_MAX_TOTAL_DURATION_MINUTES=180
# BOOKING_MAX_PRESTATIONS=3
# BOOKING_MAX_UPCOMING_PER_PHONE=3  # RDV à venir max par numéro et par salon
# BOOKING_MAX_PER_PHONE_PER_DAY=5   # réservations max par numéro en 24 h

# ---- Reverse proxy ----
# Nombre de proxys de confiance devant l'app. 0 = accès direct (dev).
# 1 derrière Caddy / Render / Fly. 2 si Cloudflare proxifie en plus.
# Ne JAMAIS mettre "true" : X-Forwarded-For deviendrait falsifiable et le
# rate limiting contournable.
TRUST_PROXY_HOPS=0
